{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "open5gs-upf",
    "namespace": "open5gs"
  },
  "spec": {
    "progressDeadlineSeconds": 600,
    "replicas": 1,
    "revisionHistoryLimit": 10,
    "selector": {
      "matchLabels": {
        "app": "open5gs-upf"
      }
    },
    "strategy": {
      "rollingUpdate": {
        "maxSurge": "25%",
        "maxUnavailable": "25%"
      },
      "type": "RollingUpdate"
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "open5gs-upf"
        }
      },
      "spec": {
        "containers": [
          {
            "command": [
              "sh",
              "-c",
              "ip link show ogstun >/dev/null 2>&1 || ip tuntap add name ogstun mode tun\nip addr show ogstun | grep -q 10.45.0.1 || ip addr add 10.45.0.1/16 dev ogstun\nip link set ogstun up\niptables -t nat -C POSTROUTING -s 10.45.0.0/16 ! -o ogstun -j MASQUERADE 2>/dev/null || \\\n  iptables -t nat -A POSTROUTING -s 10.45.0.0/16 ! -o ogstun -j MASQUERADE\nexec /opt/open5gs/bin/open5gs-upfd -c /etc/open5gs/upf.yaml\n"
            ],
            "image": "open5gs:v2.8.0",
            "imagePullPolicy": "Never",
            "name": "upf",
            "ports": [
              {
                "containerPort": 8805,
                "protocol": "UDP"
              },
              {
                "containerPort": 2152,
                "protocol": "UDP"
              }
            ],
            "resources": {},
            "securityContext": {
              "capabilities": {
                "add": [
                  "NET_ADMIN"
                ]
              },
              "privileged": true
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/etc/open5gs",
                "name": "config"
              },
              {
                "mountPath": "/dev/net/tun",
                "name": "dev-net-tun"
              }
            ]
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "restartPolicy": "Always",
        "schedulerName": "default-scheduler",
        "securityContext": {},
        "terminationGracePeriodSeconds": 30,
        "volumes": [
          {
            "configMap": {
              "defaultMode": 420,
              "name": "upf-config"
            },
            "name": "config"
          },
          {
            "hostPath": {
              "path": "/dev/net/tun",
              "type": ""
            },
            "name": "dev-net-tun"
          }
        ]
      }
    }
  }
}
