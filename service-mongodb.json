{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "mongodb",
    "namespace": "open5gs"
  },
  "spec": {
    "internalTrafficPolicy": "Cluster",
    "ipFamilies": [
      "IPv4"
    ],
    "ipFamilyPolicy": "SingleStack",
    "ports": [
      {
        "port": 27017,
        "protocol": "TCP",
        "targetPort": 27017
      }
    ],
    "selector": {
      "app": "mongodb"
    },
    "sessionAffinity": "None",
    "type": "ClusterIP"
  }
}
