{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "open5gs-amf",
    "namespace": "open5gs"
  },
  "spec": {
    "progressDeadlineSeconds": 600,
    "replicas": 1,
    "revisionHistoryLimit": 10,
    "selector": {
      "matchLabels": {
        "app": "open5gs-amf"
      }
    },
    "strategy": {
      "rollingUpdate": {
        "maxSurge": "25%",
        "maxUnavailable": "25%"
      },
      "type": "RollingUpdate"
    },
    "template": {
      "metadata": {
        "annotations": {
          "kubectl.kubernetes.io/restartedAt": "2026-08-17T11:46:41+05:30"
        },
        "labels": {
          "app": "open5gs-amf"
        }
      },
      "spec": {
        "containers": [
          {
            "args": [
              "-c",
              "/etc/open5gs/amf.yaml"
            ],
            "command": [
              "/opt/open5gs/bin/open5gs-amfd"
            ],
            "image": "open5gs:v2.8.0",
            "imagePullPolicy": "Never",
            "name": "amf",
            "ports": [
              {
                "containerPort": 7777,
                "protocol": "TCP"
              },
              {
                "containerPort": 38412,
                "protocol": "SCTP"
              }
            ],
            "resources": {},
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/etc/open5gs",
                "name": "config"
              }
            ]
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "initContainers": [
          {
            "command": [
              "sh",
              "-c",
              "until nc -z open5gs-nrf 7777; do sleep 2; done"
            ],
            "image": "busybox:1.36",
            "imagePullPolicy": "IfNotPresent",
            "name": "wait-nrf",
            "resources": {},
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File"
          }
        ],
        "restartPolicy": "Always",
        "schedulerName": "default-scheduler",
        "securityContext": {},
        "terminationGracePeriodSeconds": 30,
        "volumes": [
          {
            "configMap": {
              "defaultMode": 420,
              "name": "amf-config"
            },
            "name": "config"
          }
        ]
      }
    }
  }
}
