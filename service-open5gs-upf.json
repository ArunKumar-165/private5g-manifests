{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "open5gs-upf",
    "namespace": "open5gs"
  },
  "spec": {
    "internalTrafficPolicy": "Cluster",
    "ipFamilies": [
      "IPv4"
    ],
    "ipFamilyPolicy": "SingleStack",
    "ports": [
      {
        "name": "pfcp",
        "port": 8805,
        "protocol": "UDP",
        "targetPort": 8805
      },
      {
        "name": "gtpu",
        "port": 2152,
        "protocol": "UDP",
        "targetPort": 2152
      }
    ],
    "selector": {
      "app": "open5gs-upf"
    },
    "sessionAffinity": "None",
    "type": "ClusterIP"
  }
}
