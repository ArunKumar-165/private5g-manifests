{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "ueransim",
    "namespace": "open5gs"
  },
  "spec": {
    "progressDeadlineSeconds": 600,
    "replicas": 1,
    "revisionHistoryLimit": 10,
    "selector": {
      "matchLabels": {
        "app": "ueransim"
      }
    },
    "strategy": {
      "rollingUpdate": {
        "maxSurge": "25%",
        "maxUnavailable": "25%"
      },
      "type": "RollingUpdate"
    },
    "template": {
      "metadata": {
        "annotations": {
          "kubectl.kubernetes.io/restartedAt": "2026-08-17T11:56:43+05:30"
        },
        "labels": {
          "app": "ueransim"
        }
      },
      "spec": {
        "containers": [
          {
            "args": [
              "-c",
              "/etc/ueransim/gnb.yaml"
            ],
            "command": [
              "/usr/local/bin/nr-gnb"
            ],
            "image": "ueransim:latest",
            "imagePullPolicy": "Never",
            "name": "gnb",
            "resources": {},
            "securityContext": {
              "capabilities": {
                "add": [
                  "NET_ADMIN"
                ]
              }
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/etc/ueransim",
                "name": "config"
              }
            ]
          },
          {
            "args": [
              "sleep 10 && exec /usr/local/bin/nr-ue -c /etc/ueransim/ue.yaml"
            ],
            "command": [
              "/bin/sh",
              "-c"
            ],
            "image": "ueransim:latest",
            "imagePullPolicy": "Never",
            "name": "ue",
            "resources": {},
            "securityContext": {
              "capabilities": {
                "add": [
                  "NET_ADMIN"
                ]
              }
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/etc/ueransim",
                "name": "config"
              },
              {
                "mountPath": "/dev/net/tun",
                "name": "tun"
              }
            ]
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "restartPolicy": "Always",
        "schedulerName": "default-scheduler",
        "securityContext": {},
        "terminationGracePeriodSeconds": 30,
        "volumes": [
          {
            "configMap": {
              "defaultMode": 420,
              "name": "ueransim-config"
            },
            "name": "config"
          },
          {
            "hostPath": {
              "path": "/dev/net/tun",
              "type": "CharDevice"
            },
            "name": "tun"
          }
        ]
      }
    }
  }
}
